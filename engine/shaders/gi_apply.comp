#version 460
// Adds diffuse indirect lighting to opaque pixels. The irradiance is
// interpolated from the four nearest filtered cascade 0 probes, evaluating
// their spherical harmonics for the pixel's normal. Probes are weighted by
// distance to the pixel's surface plane to avoid leaking across depth
// discontinuities.
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

vec3 irradiance_from(Probe probe, vec3 normal) {
  // Irradiance from L1 radiance: pi * L0 * Y0 + 2 pi / 3 * L1 * Y1(n).
  vec3 e = PI * 0.282095 * probe.sh[0].rgb +
           2.0 * PI / 3.0 * 0.488603 *
               (probe.sh[1].rgb * normal.y + probe.sh[2].rgb * normal.z +
                probe.sh[3].rgb * normal.x);
  return max(e, vec3(0.0));
}

void main() {
  uvec2 pixel = gl_GlobalInvocationID.xy;
  uvec2 screen = pc.render.screen_size;
  if (any(greaterThanEqual(pixel, screen)) ||
      pc.render.debug_mode == DEBUG_MODE_DIRECT)
    return;
  float depth = texelFetch(depth_texture, ivec2(pixel), 0).r;
  if (depth >= 1.0)
    return;

  vec3 position = reconstruct_position(vec2(pixel) + 0.5, depth);
  vec3 normal = imageLoad(normal_image, ivec2(pixel)).xyz;
  float scale = distance(position, pc.render.camera_position.xyz);

  uint spacing = GI_PROBE_SPACING;
  uvec2 probes = (screen + spacing - 1u) / spacing;
  uint filtered = probes.x * probes.y; // filtered probes follow the raw ones
  vec2 coordinate = (vec2(pixel) + 0.5) / float(spacing) - 0.5;
  ivec2 base = ivec2(floor(coordinate));
  vec2 f = coordinate - vec2(base);

  vec3 irradiance = vec3(0.0);
  float weight_sum = 0.0;
  for (int y = 0; y < 2; y++) {
    for (int x = 0; x < 2; x++) {
      ivec2 q = clamp(base + ivec2(x, y), ivec2(0), ivec2(probes) - 1);
      Probe probe =
          pc.render.probes.data[filtered + uint(q.y) * probes.x + uint(q.x)];
      if (probe.position.w == 0.0)
        continue;
      float plane_distance =
          abs(dot(probe.position.xyz - position, normal)) / scale;
      float weight = (x == 0 ? 1.0 - f.x : f.x) * (y == 0 ? 1.0 - f.y : f.y);
      weight *= exp(-plane_distance * 40.0);
      weight = max(weight, 1e-5);
      irradiance += irradiance_from(probe, normal) * weight;
      weight_sum += weight;
    }
  }
  if (weight_sum <= 0.0)
    return;
  irradiance /= weight_sum;

  vec3 albedo = imageLoad(albedo_image, ivec2(pixel)).rgb;
  vec4 color = imageLoad(hdr_image, ivec2(pixel));
  if (pc.render.debug_mode == DEBUG_MODE_INDIRECT)
    color.rgb = vec3(0.0);
  color.rgb += albedo / PI * irradiance;
  imageStore(hdr_image, ivec2(pixel), color);
}
