#version 460
// Adds indirect lighting to opaque pixels from the surface parameters of the
// depth prepass: diffuse from the irradiance interpolated from the four
// nearest filtered cascade 0 probes (weighted by distance to the pixel's
// surface plane to avoid leaking across depth discontinuities), and
// specular from the environment and the probes. Pixels without geometry
// show the environment, when the scene has one.
#include "common.glsl"
#include "surface.glsl"
#include "lighting.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
  uvec2 pixel = gl_GlobalInvocationID.xy;
  uvec2 screen = render_data.screen_size;
  if (any(greaterThanEqual(pixel, screen)))
    return;
  float depth = texelFetch(depth_texture, ivec2(pixel), 0).r;
  vec3 camera = render_data.camera_position.xyz;
  if (depth >= 1.0) {
    if (render_data.environment_slot != ENVIRONMENT_NONE) {
      // Any depth along the pixel's ray gives its direction.
      vec3 direction =
          normalize(reconstruct_position(vec2(pixel) + 0.5, 0.5) - camera);
      imageStore(hdr_image, ivec2(pixel),
                 vec4(environment_radiance(direction, 0.0), 1.0));
    }
    return;
  }
  if (render_data.debug_mode == DEBUG_MODE_DIRECT)
    return;

  vec3 position = reconstruct_position(vec2(pixel) + 0.5, depth);
  vec4 surface = imageLoad(normal_image, ivec2(pixel));
  vec4 albedo = imageLoad(albedo_image, ivec2(pixel));
  Surface s;
  s.base_color = albedo.rgb;
  s.occlusion = albedo.a;
  s.normal = decode_normal(surface.xy);
  s.roughness = surface.z;
  s.metallic = surface.w;
  vec3 v = normalize(camera - position);

  vec3 diffuse, specular;
  indirect_lighting(s, vec2(pixel) + 0.5, position, v, true, diffuse,
                    specular);
  vec4 color = imageLoad(hdr_image, ivec2(pixel));
  if (render_data.debug_mode == DEBUG_MODE_INDIRECT)
    color.rgb = vec3(0.0);
  color.rgb = min(color.rgb + diffuse + specular, vec3(HALF_MAX));
  imageStore(hdr_image, ivec2(pixel), color);
}
