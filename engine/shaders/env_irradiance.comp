#version 460
// Writes the irradiance cube map: the cosine-weighted integral of the
// environment's radiance over the hemisphere around each direction.
#include "env_common.glsl"

#define SAMPLE_COUNT 256u

void main() {
  uint size = ENV_IRRADIANCE_SIZE;
  uvec3 id = gl_GlobalInvocationID;
  if (id.x >= size || id.y >= size)
    return;
  vec3 n = cube_direction(id.z, (vec2(id.xy) + 0.5) / float(size));
  float source_texel = source_texel_solid_angle();
  mat3 frame = tangent_frame(n);
  vec3 sum = vec3(0.0);
  for (uint i = 0u; i < SAMPLE_COUNT; i++) {
    vec2 xi = hammersley(i, SAMPLE_COUNT);
    float r = sqrt(xi.y);
    float phi = 2.0 * PI * xi.x;
    float cos_theta = sqrt(max(1.0 - xi.y, 0.0));
    vec3 l = frame * vec3(r * cos(phi), r * sin(phi), cos_theta);
    // Cosine-weighted samples: pdf = cos / pi.
    float pdf = max(cos_theta, 1e-4) / PI;
    float sample_solid_angle = 1.0 / (float(SAMPLE_COUNT) * pdf);
    float lod = max(0.5 * log2(sample_solid_angle / source_texel) + 1.0, 0.0);
    sum += sample_source(l, lod);
  }
  imageStore(target, ivec3(id), vec4(PI * sum / float(SAMPLE_COUNT), 1.0));
}
