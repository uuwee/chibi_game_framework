#version 460
// Writes the visible instances into the ranges assigned to their draws.
#include "cull_common.glsl"

void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= pc.render.entry_count)
    return;
  uint instance_index = pc.render.entries.data[index];
  Instance instance = pc.render.instances.data[instance_index];
  Mesh mesh = pc.render.meshes.data[instance.mesh];
  if (!instance_visible(instance, mesh))
    return;
  uint pipeline = pc.render.materials.data[instance.material].pipeline;
  uint draw = draw_index(pipeline, instance.mesh);
  uint slot = atomicAdd(pc.render.draws.data[draw].instance_count, 1u);
  pc.render.visible.data[pc.render.draws.data[draw].first_instance + slot] =
      instance_index;
}
