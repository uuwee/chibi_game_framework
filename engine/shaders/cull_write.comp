#version 460
// Writes the visible instances into the ranges assigned to their draws.
#include "cull_common.glsl"

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint view = gl_GlobalInvocationID.y;
  if (index >= render_data.entry_count)
    return;
  uint instance_index = entries[render_data.entry_offset + index];
  Instance instance = instances[instance_index];
  Mesh mesh = meshes[instance.mesh];
  uint pipeline = materials[instance.material].pipeline;
  if (pipeline >= PIPELINE_TRANSPARENT ||
      !instance_visible(instance, mesh, view))
    return;
  uint key = draw_key(view, pipeline, instance.mesh);
  uint draw = (view * DRAW_KIND_COUNT + pipeline) * MAX_MESHES +
              draw_keys[key * 2u + 1u];
  uint slot = atomicAdd(draws[draw].instance_count, 1u);
  visible[draws[draw].first_instance + slot] = instance_index;
}
