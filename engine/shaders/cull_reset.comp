#version 460
// Clears the per-(view, kind, mesh) instance counts and the draw counters.
#include "cull_common.glsl"

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint mesh_count = render_data.mesh_count;
  uint keys = render_data.view_count * DRAW_KIND_COUNT * mesh_count;
  if (index < keys) {
    uint key = (index / mesh_count) * MAX_MESHES + index % mesh_count;
    draw_keys[key * 2u] = 0u;
    draw_keys[key * 2u + 1u] = 0u;
  } else if (index - keys < COUNTER_COUNT) {
    counters[index - keys] = 0u;
  }
}
