#version 460
// Smooths the probe spherical harmonics with a 3x3 bilateral filter over
// neighboring probes on the same surface (close to the probe's plane, with a
// similar normal). One probe covers GI_PROBE_SPACING pixels, so this removes
// noise over a wide area for little work. Reads the probes written by
// gi_probe and writes the filtered copy that follows them in the buffer.
#include "common.glsl"

layout(local_size_x = 64) in;

void main() {
  uvec2 screen = pc.render.screen_size;
  uint spacing = GI_PROBE_SPACING;
  uvec2 probes = (screen + spacing - 1u) / spacing;
  uint count = probes.x * probes.y;
  uint index = gl_GlobalInvocationID.x;
  if (index >= count)
    return;
  ivec2 probe = ivec2(index % probes.x, index / probes.x);

  Probe center = pc.render.probes.data[index];
  Probe result = center;
  if (center.position.w != 0.0) {
    vec3 normal = vec3(center.sh[1].w, center.sh[2].w, center.sh[3].w);
    float scale = distance(center.position.xyz, pc.render.camera_position.xyz);
    vec3 sh[4] = vec3[4](vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0));
    float weight_sum = 0.0;
    for (int y = -1; y <= 1; y++) {
      for (int x = -1; x <= 1; x++) {
        ivec2 q = probe + ivec2(x, y);
        if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, ivec2(probes))))
          continue;
        Probe neighbor = pc.render.probes.data[q.y * int(probes.x) + q.x];
        if (neighbor.position.w == 0.0)
          continue;
        vec3 neighbor_normal =
            vec3(neighbor.sh[1].w, neighbor.sh[2].w, neighbor.sh[3].w);
        float plane_distance =
            abs(dot(neighbor.position.xyz - center.position.xyz, normal)) /
            scale;
        float weight = (x == 0 ? 1.0 : 0.6) * (y == 0 ? 1.0 : 0.6) *
                       exp(-plane_distance * 40.0) *
                       pow(max(dot(normal, neighbor_normal), 0.0), 8.0);
        for (int i = 0; i < 4; i++)
          sh[i] += neighbor.sh[i].rgb * weight;
        weight_sum += weight;
      }
    }
    for (int i = 0; i < 4; i++)
      result.sh[i].rgb = sh[i] / weight_sum;
  }
  pc.render.probes.data[count + index] = result;
}
