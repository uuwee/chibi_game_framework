#version 460
// Screen-space radiance cascades. One dispatch computes one cascade, from the
// top cascade down. Cascade c places a probe every (GI_PROBE_SPACING << c)
// pixels on the depth buffer and stores (GI_DIRECTIONS << c)^2 directions per
// probe in an octahedral tile.
//
// Each texel is pre-averaged over the four directions that subdivide its
// cell (the directions of the next cascade): every sub-direction traces the
// ray interval of this cascade through the depth buffer and is merged with
// the radiance arriving from beyond the interval in that same direction (the
// next cascade, or the sky for the top one), then the four are averaged.
// Sampling several directions per texel keeps small bright surfaces from
// flickering in and out of a single ray.
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

float interval_start(uint cascade) {
  // Interval lengths grow 4x per cascade: [0, L), [L, 5L), [5L, 21L), ...
  return pc.render.gi_interval * (float(1u << (2u * cascade)) - 1.0) / 3.0;
}

float noise(uvec2 texel) {
  // Interleaved gradient noise, to hide the stepping pattern of the march.
  return fract(52.9829189 *
               fract(dot(vec2(texel), vec2(0.06711056, 0.00583715))));
}

// Marches [t0, t1) from origin through the given pyramid level. rgb:
// radiance found, a: transmittance (1 when nothing was hit). Positions are
// linear in clip space and view depth is linear along the ray, so each step
// needs no matrix product, and one load returns both radiance and depth.
vec4 trace(vec3 origin, vec3 direction, float t0, float t1, uint steps,
           float jitter, DepthRows rows, uint level) {
  vec2 screen = vec2(pc.render.screen_size);
  vec2 level_size = vec2(imageSize(pyramid_levels[level]));
  vec4 clip_origin = pc.render.view_projection * vec4(origin, 1.0);
  vec4 clip_direction = pc.render.view_projection * vec4(direction, 0.0);
  float depth_origin = world_view_depth(rows, origin);
  float depth_direction = dot(rows.view.xyz, direction) * rows.sign;
  float step_length = (t1 - t0) / float(steps);
  float thickness = max(0.25, step_length * 2.0);
  for (uint i = 0u; i < steps; i++) {
    float t = t0 + (float(i) + jitter) * step_length;
    vec4 clip = clip_origin + clip_direction * t;
    if (clip.w <= 0.0)
      break;
    vec3 ndc = clip.xyz / clip.w;
    if (any(greaterThan(abs(ndc.xy), vec2(1.0))) || ndc.z < 0.0 || ndc.z > 1.0)
      break;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    vec4 scene = imageLoad(pyramid_levels[level], ivec2(uv * level_size));
    if (scene.a >= SKY_DEPTH)
      continue;
    float behind = depth_origin + depth_direction * t - scene.a;
    if (behind > 0.0 && behind < thickness) {
      vec3 normal = imageLoad(normal_image, ivec2(uv * screen)).xyz;
      if (dot(normal, direction) > 0.1)
        continue; // back side of a surface; keep looking
      return vec4(scene.rgb, 0.0);
    }
  }
  return vec4(0.0, 0.0, 0.0, 1.0);
}


void main() {
  uint cascade = pc.cascade;
  uint spacing = GI_PROBE_SPACING << cascade;
  uint directions = GI_DIRECTIONS << cascade;
  uvec2 screen = pc.render.screen_size;
  uvec2 probes = (screen + spacing - 1u) / spacing;
  uvec2 texel = gl_GlobalInvocationID.xy;
  if (any(greaterThanEqual(texel, probes * directions)))
    return;

  uvec2 probe = texel / directions;
  uvec2 cell = texel % directions;
  vec3 sky = pc.render.sky.rgb;

  ivec2 probe_pixel = ivec2(min(probe * spacing + spacing / 2u, screen - 1u));
  float depth = texelFetch(depth_texture, probe_pixel, 0).r;
  if (depth >= 1.0) {
    imageStore(cascade_images[cascade], ivec2(texel), vec4(sky, 0.0));
    return;
  }

  vec3 camera = pc.render.camera_position.xyz;
  vec3 position = reconstruct_position(vec2(probe_pixel) + 0.5, depth);
  vec3 normal = imageLoad(normal_image, probe_pixel).xyz;
  float probe_distance = distance(position, camera);
  vec3 origin = position + normal * 0.03;

  // The four nearest probes of the next cascade, with bilinear weights
  // reduced for probes whose depth differs from this probe's.
  bool merge = cascade + 1u < pc.render.cascade_count;
  uint upper = cascade + 1u;
  uint upper_spacing = spacing * 2u;
  uint upper_directions = directions * 2u;
  ivec2 upper_probe[4];
  float upper_weight[4];
  float weight_sum = 0.0;
  if (merge) {
    uvec2 upper_probes = (screen + upper_spacing - 1u) / upper_spacing;
    vec2 coordinate = (vec2(probe * spacing) + 0.5 * float(spacing)) /
                          float(upper_spacing) - 0.5;
    ivec2 base = ivec2(floor(coordinate));
    vec2 f = coordinate - vec2(base);
    for (int i = 0; i < 4; i++) {
      ivec2 offset = ivec2(i & 1, i >> 1);
      ivec2 q = clamp(base + offset, ivec2(0), ivec2(upper_probes) - 1);
      float weight = (offset.x == 0 ? 1.0 - f.x : f.x) *
                     (offset.y == 0 ? 1.0 - f.y : f.y);
      ivec2 q_pixel = ivec2(min(uvec2(q) * upper_spacing + upper_spacing / 2u,
                                screen - 1u));
      float q_depth = texelFetch(depth_texture, q_pixel, 0).r;
      if (q_depth < 1.0) {
        vec3 q_position = reconstruct_position(vec2(q_pixel) + 0.5, q_depth);
        float difference = abs(distance(q_position, camera) - probe_distance);
        weight *= 1.0 / (1.0 + 8.0 * difference / probe_distance);
      } else {
        weight *= 0.05;
      }
      upper_probe[i] = q;
      upper_weight[i] = max(weight, 1e-4);
      weight_sum += upper_weight[i];
    }
  }

  uint steps = cascade == 0u ? 4u : 8u;
  float t0 = interval_start(cascade);
  float t1 = interval_start(cascade + 1u);
  float jitter = noise(texel);
  DepthRows rows = depth_rows();
  // Finer cascades trace finer pyramid levels.
  uint level = min(cascade, GI_PYRAMID_LEVELS - 1u);
  vec3 radiance = vec3(0.0);
  for (uint sub = 0u; sub < 4u; sub++) {
    uvec2 child = cell * 2u + uvec2(sub & 1u, sub >> 1u);
    vec3 direction =
        octahedral_decode((vec2(child) + 0.5) / float(directions * 2u));
    vec4 near = trace(origin, direction, t0, t1, steps, jitter, rows, level);

    vec3 far = sky;
    if (near.a > 0.0 && merge) {
      far = vec3(0.0);
      for (int i = 0; i < 4; i++) {
        ivec2 upper_texel = upper_probe[i] * int(upper_directions) +
                            ivec2(child);
        far += imageLoad(cascade_images[upper], upper_texel).rgb *
               upper_weight[i];
      }
      far /= weight_sum;
    }
    radiance += near.rgb + near.a * far;
  }

  imageStore(cascade_images[cascade], ivec2(texel), vec4(radiance * 0.25, 0.0));
}
