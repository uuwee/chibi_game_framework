#version 460
// Counts the visible instances of each (view, kind, mesh), and collects the
// transparent instances in view with their sort keys.
#include "cull_common.glsl"

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint view = gl_GlobalInvocationID.y;
  if (index >= render_data.entry_count)
    return;
  uint instance_index = entries[render_data.entry_offset + index];
  Instance instance = instances[instance_index];
  Mesh mesh = meshes[instance.mesh];
  uint pipeline = materials[instance.material].pipeline;
  bool transparent = pipeline >= PIPELINE_TRANSPARENT;
  if (transparent && view != 0u)
    return; // transparent surfaces cast no shadows
  if (!instance_visible(instance, mesh, view))
    return;
  if (transparent) {
    uint slot = atomicAdd(counters[COUNTER_TRANSPARENT_FOUND], 1u);
    if (slot < TRANSPARENT_CAPACITY) {
      vec3 center = (instance.transform * vec4(mesh.sphere.xyz, 1.0)).xyz;
      float distance = length(center - render_data.camera_position.xyz);
      // Ascending keys draw the farthest first; ties keep the scene order.
      transparent_keys[slot] = uvec2(~floatBitsToUint(distance), index);
    }
    return;
  }
  atomicAdd(draw_keys[draw_key(view, pipeline, instance.mesh) * 2u], 1u);
}
